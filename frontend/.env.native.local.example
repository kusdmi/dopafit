# Copy this file to .env.native.local (gitignored) and set your LAN IP.
# VITE_TARGET is inherited from .env.native — do not duplicate it here.
#
# A real device cannot reach the host via "localhost"; use the LAN IP instead.
# Find your LAN IP on macOS: ipconfig getifaddr en0
VITE_API_URL=http://<LAN-IP>:8000
