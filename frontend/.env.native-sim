# Native (Capacitor) build mode для iOS-СИМУЛЯТОРА. Подхватывается `vite build --mode native-sim`.
# VITE_TARGET=native отключает service worker / PWA в vite.config.ts.
VITE_TARGET=native
# Симулятор делит сеть с Mac → backend доступен по localhost (НЕ LAN-IP, как на реальном устройстве).
VITE_API_URL=http://localhost:8000
