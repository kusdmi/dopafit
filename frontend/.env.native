# Native (Capacitor) build mode. Picked up by `vite build --mode native`.
# VITE_TARGET=native disables service worker / PWA in vite.config.ts.
VITE_TARGET=native

# VITE_API_URL is intentionally absent here.
#
# Dev (on a real device):
#   Copy .env.native.local.example → .env.native.local and set your LAN IP.
#   .env.native.local is gitignored (.env.*.local) and loaded automatically by Vite.
#
# Prod (release APK / CI):
#   Pass as a shell variable: VITE_API_URL=https://api.dopafit.ru pnpm build:native
#   Starting from the build-time guard in vite.config.ts, a build without VITE_API_URL
#   fails with an explicit error — silent localhost default is no longer possible.
