{
  "name": "dopafit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "build:native-sim": "tsc --noEmit && vite build --mode native-sim",
    "build:native-android": "tsc --noEmit && vite build --mode native-android",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "test": "vitest",
    "test:run": "vitest run",
    "codegen": "openapi-typescript ${OPENAPI_SPEC:-/contracts/openapi.json} -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8",
    "@capacitor-community/sqlite": "^8",
    "@capacitor/action-sheet": "^8",
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "^8",
    "@capacitor/camera": "^8",
    "@capacitor/core": "^8",
    "@capacitor/filesystem": "^8",
    "@capacitor/ios": "8.4.3",
    "@capacitor/keyboard": "^8",
    "@capacitor/local-notifications": "^8",
    "@capacitor/network": "^8",
    "@capacitor/preferences": "^8",
    "@capacitor/push-notifications": "^8",
    "@capacitor/share": "^8",
    "@capacitor/splash-screen": "^8",
    "@capacitor/status-bar": "^8",
    "@capgo/capacitor-autofill-save-password": "^8.0.34",
    "@capgo/capacitor-navigation-bar": "^8.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@yandex/smart-captcha": "2.9.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.60.0",
    "react-router": "^7.9.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3",
    "@capacitor/cli": "^8",
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.14.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
