VITE_API_URL=http://localhost:8000
# true = frontend works fully offline against MSW mocks
VITE_API_MOCK=true

# Публичный ключ VAPID для web-push. Без него registerWeb() выходит сразу и
# разрешение на уведомления даже не запрашивается — то есть пуши молча не
# работают, что и было основной причиной «уведомление не приходит».
#
# Значение НЕ секретно (браузер и так отдаёт его push-сервису), но пара у
# каждого окружения своя, поэтому в репозитории строка закомментирована.
#
# Сгенерировать пару (в Docker, не на хосте):
#   make push-keys
# Публичный ключ — сюда, приватный — в окружение бэкенда как
# DOPAFIT_VAPID_PRIVATE_KEY (см. backend/.env.example). Ключи должны быть из
# ОДНОЙ пары, иначе push-сервис отвергнет отправку.
#
# Локально удобнее держать значение в .env.development.local (он в gitignore).
#VITE_VAPID_PUBLIC_KEY=
