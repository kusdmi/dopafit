# Copy to ~/dopafit/.env on the VPS. This file is read by docker compose itself
# (variable interpolation) — unlike .env.prod, its values are NOT passed into the
# app container (except the domain, which compose forwards to the caddy service).

# The domain served by Caddy. TLS certificates are issued automatically;
# a DNS A record must point at this VPS. One domain is enough: the app serves
# the PWA and the API together.
DOPAFIT_APP_DOMAIN=app.example.com

# Stage 15.2 (registry + CI/CD): uncomment to pull the image from a registry
# instead of the local one loaded by deploy.sh. Until then leave commented —
# the default is dopafit-app:latest.
#DOPAFIT_IMAGE_PREFIX=ghcr.io/<org>/dopafit
#DOPAFIT_IMAGE_TAG=<git-sha>
