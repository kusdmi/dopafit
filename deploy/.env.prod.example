# Copy to ~/dopafit/.env.prod on the VPS and fill in. NEVER commit the real file.
# Generate secrets with: openssl rand -hex 32

DOPAFIT_ENVIRONMENT=prod

# External PostgreSQL
# NOTE: do NOT put ?sslmode=... in the URL. The pg driver builds its own TLS config
# from that parameter and ignores the `ca` passed by createDatabase
# (backend/src/platform/db/index.ts) - the connection then fails with
# SELF_SIGNED_CERT_IN_CHAIN. Verification is NOT weakened by leaving it out:
# ca + rejectUnauthorized:true in code are the equivalent of verify-full.
DOPAFIT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# TLS to Postgres with a private CA (typical for managed DBs): put the provider's
# root certificate at ~/dopafit/certs/pg-root.crt and uncomment (verify-full).
#
# The path is the one INSIDE the container: ~/dopafit/certs is mounted as
# /certs:ro by docker-compose.prod.yml. Host paths and $HOME are not expanded
# here. Verification is strict (rejectUnauthorized), so a self-signed
# certificate without a chain is refused - see backend/src/platform/db/index.ts.
# Note: the libpq variable PGSSLROOTCERT is NOT read by the pg driver; only
# this variable has any effect. Rotation = replace the file, restart the stack.
#DOPAFIT_DATABASE_SSL_ROOT_CERT=/certs/pg-root.crt

# openssl rand -hex 32
DOPAFIT_JWT_SECRET=

# External S3-compatible storage.
# S3_ENDPOINT — how the app reaches the storage, including the scheme.
# S3_PUBLIC_ENDPOINT — public address used in presigned URLs (what the browser sees).
#
# Keep PUBLIC_ENDPOINT on the SAME host as ENDPOINT unless the provider signs for
# the alias too: SigV4 covers the host, so a presigned URL rewritten to a custom
# domain (e.g. a CDN alias) is rejected with SignatureDoesNotMatch. Serving photos
# from such an alias would require making the bucket publicly readable - which
# defeats presigned URLs and exposes every object to anyone who knows its path.
DOPAFIT_S3_ENDPOINT=https://s3.example.com
DOPAFIT_S3_PUBLIC_ENDPOINT=https://s3.example.com
DOPAFIT_S3_ACCESS_KEY=
DOPAFIT_S3_SECRET_KEY=
# Use the bucket name the provider actually created (managed S3 often assigns a UUID).
# The app only creates a bucket when HeadBucket returns 404 and the key is allowed to;
# with a wrong name the startup fails with AccessDenied.
DOPAFIT_S3_BUCKET=measurements

# The PWA is served from the same origin as the API, so no cross-origin request
# is made and this can stay empty. Native builds call the API from their own
# WebView origin and will need entries here — a JSON list, exactly as written,
# with no outer quotes: ["https://localhost","capacitor://localhost"]
#DOPAFIT_CORS_ORIGINS=[]

# Real email. Fill in host and mailbox password outside git.
# 587 = mandatory STARTTLS; 465 = TLS on connect. Both verify certificates.
DOPAFIT_NOTIFICATION_PROVIDER=smtp
DOPAFIT_SMTP_HOST=
DOPAFIT_SMTP_PORT=587
DOPAFIT_SMTP_USER=auth@dopafit.ru
DOPAFIT_SMTP_PASSWORD=
# SMTP refuses fixed codes even when ALLOW_FIXED_VERIFICATION_CODE was enabled.
DOPAFIT_DEV_VERIFICATION_CODE=
DOPAFIT_ALLOW_FIXED_VERIFICATION_CODE=false
DOPAFIT_ALLOW_UNDELIVERED_NOTIFICATIONS=false

# Public key is safe to publish; the server key is a secret. Allow the app domain
# in Yandex SmartCaptcha settings; do not disable domain validation there.
DOPAFIT_SMARTCAPTCHA_SITE_KEY=ysc1_6awhCKX7VRAK4f1ph7Qvv8RWxyVP7rmp1dEojEpx6b2c5d53
DOPAFIT_SMARTCAPTCHA_SECRET_KEY=
DOPAFIT_SMARTCAPTCHA_ALLOWED_HOSTS=app.dopafit.ru

# ---- Web Push (VAPID) ----
# Required in production: config.ts refuses to start without them, because the
# failure mode is silent (the frontend just hides the notifications button, so
# push looks "not implemented" rather than misconfigured). Generate a pair on the
# dev machine with `make push-keys` and paste it here.
#
# The PUBLIC key also has to be baked into the frontend bundle, since the browser
# reads it at build time - deploy.sh takes it from this file and passes it as the
# VITE_VAPID_PUBLIC_KEY build argument, so keeping it here is enough. A
# subscription taken out under one public key is refused by a server holding
# another.
#
# SECURITY: the private key is a secret, exactly like DOPAFIT_JWT_SECRET. Never
# commit it. Rotating the pair invalidates every existing subscription, so every
# user has to enable notifications again.
DOPAFIT_VAPID_PUBLIC_KEY=
DOPAFIT_VAPID_PRIVATE_KEY=
# Contact the push service may use to reach the operator: mailto: or https://.
DOPAFIT_VAPID_SUBJECT=mailto:admin@example.com

# The only supported provider in stage 15.1
DOPAFIT_PAYMENT_PROVIDER=mock

# Links handed to users. The defaults in config.ts point at dopafit.app, so set
# them explicitly when the stand runs on its own domain.
#DOPAFIT_INVITE_BASE_URL=https://app.example.com
#DOPAFIT_SUBSCRIPTION_EXTERNAL_URL=https://app.example.com/subscription

# Optional; the defaults suit the stand. DOPAFIT_TRUST_PROXY is already set by
# docker-compose.prod.yml (the app sits behind Caddy).
#DOPAFIT_S3_REGION=us-east-1
#DOPAFIT_PORT=8000
#DOPAFIT_CUSTOM_EXERCISE_LIMIT_DEFAULT=10
#DOPAFIT_SCHEDULER_INTERVAL_SECONDS=300

# The full list of variables config.ts understands, with defaults:
# backend/.env.example
