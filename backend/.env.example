# Справочник по переменным окружения бэкенда: всё, что понимает
# backend/src/config.ts, со значениями по умолчанию. Файл документирует, а не
# задаёт конфигурацию — все строки закомментированы намеренно.
#
# ВАЖНО: бэкенд НЕ читает .env-файлы. Нет ни dotenv, ни --env-file: config.ts
# берёт только process.env, то есть окружение процесса. Переменные приходят:
#   dev  — из docker-compose.yml (якорь &env, сервисы workspace/backend);
#   prod — из ~/dopafit/.env.prod на VPS (env_file в docker-compose.prod.yml,
#          шаблон deploy/.env.prod.example).
# Скопировать этот файл в backend/.env недостаточно — его никто не прочитает.
#
# Имена даны целиком; в коде префикс DOPAFIT_ добавляется автоматически.

# ---- Окружение ----
# prod | production включают строгие проверки: приложение откажется стартовать
# с dev-дефолтами вместо секретов (см. «Insecure production configuration»).
#DOPAFIT_ENVIRONMENT=dev

# ---- База данных ----
#DOPAFIT_DATABASE_URL=postgresql://dopafit:dopafit@postgres:5432/dopafit_hono
# Путь к корневому сертификату CA внутри контейнера. Непустое значение включает
# TLS со строгой проверкой цепочки. libpq-переменная PGSSLROOTCERT не читается.
#DOPAFIT_DATABASE_SSL_ROOT_CERT=

# ---- Сеть ----
#DOPAFIT_HOST=0.0.0.0
#DOPAFIT_PORT=8000
# Включать только за доверенным прокси: клиентский IP начнёт браться из
# X-Forwarded-For, а на нём держатся лимиты отправки кодов.
#DOPAFIT_TRUST_PROXY=false
# JSON-список origin'ов без внешних кавычек. PWA ходит на свой origin, поэтому
# нужен в основном native-сборкам: ["https://localhost","capacitor://localhost"]
#DOPAFIT_CORS_ORIGINS=["http://localhost:5173"]

# ---- Секреты и доступ ----
# В prod обязателен, минимум 32 символа: openssl rand -hex 32
#DOPAFIT_JWT_SECRET=
# Фиксированный код вместо случайного. В prod требует ALLOW_FIXED ниже:
# зная email, с ним можно войти в любой аккаунт.
#DOPAFIT_DEV_VERIFICATION_CODE=000000
#DOPAFIT_ALLOW_FIXED_VERIFICATION_CODE=false
# Legacy test stand only: logging delivery requires this explicit opt-in in prod.
#DOPAFIT_ALLOW_UNDELIVERED_NOTIFICATIONS=false
# logging (dev/e2e) | smtp (real email). SMTP requires an empty fixed code above.
#DOPAFIT_NOTIFICATION_PROVIDER=logging
# SMTP authentication uses the mailbox address and password. TLS verification is strict.
#DOPAFIT_SMTP_HOST=
#DOPAFIT_SMTP_PORT=587
#DOPAFIT_SMTP_USER=auth@dopafit.ru
#DOPAFIT_SMTP_PASSWORD=
# 587 requires STARTTLS; 465 uses TLS from connection start. SMS is not supported.

# CAPTCHA is enabled when its server key is set. The public key is sent to the
# frontend by GET /api/v1/auth/captcha-config; never expose the server key.
#DOPAFIT_SMARTCAPTCHA_SECRET_KEY=
# Defaults to the DopaFit public key supplied for this integration.
#DOPAFIT_SMARTCAPTCHA_SITE_KEY=ysc1_6awhCKX7VRAK4f1ph7Qvv8RWxyVP7rmp1dEojEpx6b2c5d53
# Comma-separated hostnames, without scheme/port; prod default = app.dopafit.ru.
#DOPAFIT_SMARTCAPTCHA_ALLOWED_HOSTS=localhost
# Поддерживается только mock.
#DOPAFIT_PAYMENT_PROVIDER=mock

# ---- Время жизни токенов ----
#DOPAFIT_ACCESS_TOKEN_TTL_MINUTES=15
#DOPAFIT_REFRESH_TOKEN_TTL_DAYS=30
#DOPAFIT_VERIFICATION_CODE_TTL_MINUTES=10
#DOPAFIT_VERIFICATION_TOKEN_TTL_MINUTES=15
#DOPAFIT_REGISTRATION_TOKEN_TTL_MINUTES=30
#DOPAFIT_TWO_FACTOR_TOKEN_TTL_MINUTES=5
# Срок, за который контакт должен быть подтверждён.
#DOPAFIT_VERIFICATION_DEADLINE_DAYS=90

# ---- Лимиты отправки кодов ----
#DOPAFIT_CODE_SEND_MIN_INTERVAL_SECONDS=60
#DOPAFIT_CODE_SEND_MAX_PER_CONTACT_HOUR=5
#DOPAFIT_CODE_SEND_MAX_PER_CONTACT_DAY=10
#DOPAFIT_CODE_SEND_MAX_PER_IP_HOUR=20

# ---- S3-совместимое хранилище ----
# ENDPOINT — адрес для сервера, PUBLIC_ENDPOINT — для браузера (presigned-ссылки).
# Схема обязательна; учётные данные в URL запрещены.
#DOPAFIT_S3_ENDPOINT=http://minio:9000
#DOPAFIT_S3_PUBLIC_ENDPOINT=http://localhost:9000
#DOPAFIT_S3_REGION=us-east-1
#DOPAFIT_S3_BUCKET=measurements
#DOPAFIT_S3_ACCESS_KEY=dopafit
# В prod обязателен и не должен совпадать с dev-значением.
#DOPAFIT_S3_SECRET_KEY=

# ---- Обработка изображений ----
# Большая сторона в пикселях, до которой ужимается загруженное фото.
#DOPAFIT_IMAGE_MAX_DIMENSION=1600
#DOPAFIT_IMAGE_JPEG_QUALITY=80

# ---- Размеры запросов ----
#DOPAFIT_MAX_REQUEST_BODY_BYTES=
#DOPAFIT_MAX_MEDIA_UPLOAD_BYTES=

# ---- Web Push (VAPID) ----
# Пара ключей, которой сервер подписывается перед push-сервисом браузера
# (FCM/APNs/Mozilla). БЕЗ НЕЁ ПУШИ НЕ ОТПРАВЛЯЮТСЯ ВООБЩЕ: приложение стартует
# как раньше, подписки сохраняются, но доставка помечается как неудавшаяся.
#
# Сгенерировать пару (в Docker, не на хосте):
#   make push-keys
# Команда печатает публичный и приватный ключ и НИЧЕГО не записывает.
#
# Публичный ключ должен ОДНОВРЕМЕННО попасть на фронтенд как
# VITE_VAPID_PUBLIC_KEY — подписка, оформленная под один публичный ключ,
# не принимается сервером с другим.
#
# ⚠️ ПРИВАТНЫЙ КЛЮЧ — СЕКРЕТ. В git не коммитить. Смена пары обнуляет все
# существующие подписки: пользователям придётся включить уведомления заново.
#DOPAFIT_VAPID_PUBLIC_KEY=
#DOPAFIT_VAPID_PRIVATE_KEY=
# Контакт оператора для push-сервиса: mailto: или https://. Обязателен, когда
# задана пара ключей.
#DOPAFIT_VAPID_SUBJECT=mailto:admin@example.com

# ---- Фоновый планировщик ----
#DOPAFIT_SCHEDULER_INTERVAL_SECONDS=300
# После скольких часов зависший запуск считается устаревшим.
#DOPAFIT_SCHEDULER_STALE_RUN_HOURS=1

# ---- Прочее ----
# Каталог со собранным фронтендом, который отдаёт бэкенд.
#DOPAFIT_PUBLIC_DIRECTORY=/app/public
# Сколько своих упражнений можно создать (0 — без ограничения).
#DOPAFIT_CUSTOM_EXERCISE_LIMIT_DEFAULT=10
#DOPAFIT_INVITE_BASE_URL=https://dopafit.app
#DOPAFIT_SUBSCRIPTION_EXTERNAL_URL=https://app.dopafit.ru/subscription
