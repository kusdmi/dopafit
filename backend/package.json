{
  "name": "dopafit-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/platform/email/assets dist/platform/email/assets",
    "start": "node dist/server.js",
    "lint": "prettier --check src tests-ts scripts && eslint src tests-ts scripts --no-warn-ignored && tsc --noEmit",
    "format": "prettier --write src tests-ts scripts && eslint src tests-ts scripts --no-warn-ignored --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text",
    "export-openapi": "tsx scripts/export-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "db:seed": "tsx src/platform/db/seed.ts",
    "e2e:reset": "tsx scripts/e2e-reset.ts",
    "push:keys": "tsx scripts/generate-vapid-keys.ts",
    "push:test": "tsx scripts/send-test-push.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.2.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.4",
    "jose": "^6.1.3",
    "nodemailer": "10.3.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.0"
  }
}
